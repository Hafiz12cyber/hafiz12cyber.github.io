{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agristat-caraga-api",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-10-11",
  "vars": {
    "APP_ORIGIN": "https://agristat-caraga.github.io",
    "ENVIRONMENT": "production"
  },
  "d1_databases": [{
    "binding": "DB",
    "database_name": "agristat-caraga",
    "database_id": "cc13a089-0b05-499e-940e-ae2ece0de693",
    "migrations_dir": "worker/migrations"
  }],
  "r2_buckets": [{
    "binding": "PROFILE_PHOTOS",
    "bucket_name": "agristat-caraga"
  }],
  "ratelimits": [{
    "name": "LOGIN_LIMITER",
    "namespace_id": "1001",
    "simple": { "limit": 5, "period": 60 }
  }]
}